{
  "name": "bpmn-editor-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "test:visual": "playwright test --project=msedge",
    "test:visual:update": "playwright test --project=msedge --update-snapshots",
    "test:visual:headed": "set PW_VISUAL_MODE=debug&& playwright test --project=msedge --headed --workers=1",
    "test:visual:headed:slow": "set PW_VISUAL_MODE=debug&& set PW_SLOWMO=250&& playwright test --project=msedge --headed --workers=1",
    "test:visual:ui": "playwright test --project=msedge --ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "bpmn-auto-layout": "^1.1.1",
    "bpmn-js": "^18.5.0",
    "monaco-editor": "^0.52.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-monaco-editor": "^1.1.0"
  }
}
